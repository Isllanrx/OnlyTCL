# ==============================================================================
# OnlyTCL - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env at the root of the repository:
#   copy .env.example .env  (Windows) or cp .env.example .env (Linux/macOS)
# ==============================================================================

# Target Android TV IP and Port for ADB over Wi-Fi
TV_IP=192.168.1.100
TV_PORT=5555
TV_DEVICE=192.168.1.100:5555

# Android SDK Path (defaults to system ANDROID_HOME or ANDROID_SDK_ROOT if set)
ANDROID_SDK_ROOT=C:\Android\Sdk
# ANDROID_HOME=C:\Android\Sdk

# ADB Executable Path (defaults to 'adb' from PATH)
ADB_PATH=adb

# Project Root Directory for backups, dumps, and builds
PROJECT_ROOT=.

# Output directory for test captures, logs, and dumps
OUTPUT_DIR=./output
