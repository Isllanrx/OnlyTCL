# ==============================================================================
# OnlyTCL - Arquivo de Exemplo de Variaveis de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env na raiz do repositorio para personalizar:
#   copy exemplo.env .env  (Windows) ou cp exemplo.env .env (Linux/macOS)
# ==============================================================================

# Endereco IP e porta da Smart TV TCL para conexao ADB via Wi-Fi
TV_IP=192.168.1.100
TV_PORT=5555
TV_DEVICE=192.168.1.100:5555

# Caminho raiz do Android SDK (opcional se ANDROID_HOME ou ANDROID_SDK_ROOT ja estiverem no sistema)
ANDROID_SDK_ROOT=C:\Android\Sdk
# ANDROID_HOME=C:\Android\Sdk

# Caminho para o executavel do ADB (se nao estiver no PATH do sistema)
ADB_PATH=adb

# Diretorio raiz do projeto para geracao de builds e dumps (padrao: raiz do repositorio)
PROJECT_ROOT=.

# Diretorio de saida para logs, dumps de sistema e capturas de tela (screenshots)
OUTPUT_DIR=./output
